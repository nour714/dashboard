# AfricaTravel - Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL — Supabase project "africatravel", eu-west-1)
# Get the [PASSWORD] from: Supabase Dashboard → Project africatravel → Settings → Database → Connection string
# (the password is never exposed via the API, only shown once at project creation / on reset)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[YOUR_SUPABASE_POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# Authentication & JWT Secrets
# Required in every environment. Generate with: openssl rand -hex 32.
JWT_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32"
JWT_EXPIRES_IN="15m"

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://africiatravel.vercel.app"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_API=300

# Seeder & Initial Admin
# Required in every environment (minimum 12 characters); do not commit a real value.
DEFAULT_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_BOOTSTRAP_PASSWORD"

# Upstash Redis (required for shared serverless rate limits on Vercel)
UPSTASH_REDIS_REST_URL="https://YOUR_DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Supabase Storage (for passport document uploads — private bucket)
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_STORAGE_BUCKET="customer-documents"

# Google Gemini API (for AI ticket extraction from PDF/images)
# Get from: Google AI Studio → https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.7-flash"
