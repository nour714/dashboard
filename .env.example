# AfricaTravel - Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL — Supabase project "africatravel", eu-west-1)
# Get the [PASSWORD] from: Supabase Dashboard → Project africatravel → Settings → Database → Connection string
# (the password is never exposed via the API, only shown once at project creation / on reset)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.ismizpdvycxvyiwwzvbg.supabase.co:5432/postgres?schema=public"

# Authentication & JWT Secrets
# Generate a secure random value for production with: openssl rand -hex 64
# NEVER reuse the example/default values below in production.
JWT_SECRET="africatravel_super_secret_jwt_access_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="africatravel_super_secret_jwt_refresh_key_2026_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_API=300

# Seeder
DEFAULT_ADMIN_PASSWORD="password123"
