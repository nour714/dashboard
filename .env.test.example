# AfricaTravel - Test Environment Configuration
# Copy this file to .env.test for running tests locally: cp .env.test.example .env.test

NODE_ENV=test
PORT=3001

# Test Database Connection (mocked in unit tests; provide real Postgres only if running test:postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/africatravel_test?schema=public"
TEST_DATABASE_URL=

# Test JWT Secrets (must satisfy min 32 characters)
JWT_SECRET="test_suite_jwt_secret_do_not_use_in_production_key_000000"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test_suite_jwt_refresh_secret_do_not_use_in_prod_000000"
JWT_REFRESH_EXPIRES_IN="7d"

# Test Admin Password (must satisfy min 12 characters)
DEFAULT_ADMIN_PASSWORD="TestOnlyAdminPassword123!"

# CORS & Rate Limiting
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=1000
RATE_LIMIT_MAX_API=10000

# Optional test integrations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="customer-documents"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.7-flash"
