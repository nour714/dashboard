{
  "name": "africatravel",
  "version": "1.0.0",
  "description": "AfricaTravel — Internal Travel Agency Management System",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "reset:passwords": "node scripts/reset-admin-passwords.js",
    "test:business-flow": "node test/business-flow.test.js",
    "test:ticket-status": "node test/ticket-payment-status.test.js",
    "test:frontend": "node test/business-flow.test.js && node test/i18n-bilingual.test.js",
    "test:domain": "node test/backend-domain.test.js",
    "test:auth": "node test/backend-auth.test.js",
    "test:api": "node test/backend-api.test.js",
    "test:tickets": "node test/ticket-customer-link.test.js",
    "test:passport": "node test/passport-document.test.js",
    "test:roundtrip": "node test/round-trip-flight.test.js",
    "test:customer-payments": "node test/customer-payments-report.test.js",
    "test:rbac": "node test/rbac-ui.test.js",
    "test:security": "node test/security-fixes.test.js",
    "test:audit": "node test/audit-fixes.test.js",
    "test:purge": "node test/purge-actions.test.js",
    "test:employee-delete": "node test/employee-delete.test.js",
    "test:expenses": "node test/expenses.test.js",
    "test:ai-extract": "node test/ticket-extraction.test.js",
    "test:pwa": "node test/pwa-install.test.js",
    "test": "node test/business-flow.test.js && node test/ticket-payment-status.test.js && node test/i18n-bilingual.test.js && node test/backend-domain.test.js && node test/backend-auth.test.js && node test/ticket-customer-link.test.js && node test/passport-document.test.js && node test/round-trip-flight.test.js && node test/customer-payments-report.test.js && node test/rbac-ui.test.js && node test/security-fixes.test.js && node test/backend-api.test.js && node test/audit-fixes.test.js && node test/purge-actions.test.js && node test/employee-delete.test.js && node test/expenses.test.js && node test/ticket-extraction.test.js && node test/pwa-install.test.js"
  },
  "keywords": [
    "travel",
    "agency",
    "ticketing",
    "operations",
    "i18n",
    "rtl",
    "backend",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "AfricaTravel Engineering",
  "license": "ISC",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
