{
  "name": "africatravel",
  "version": "1.0.0",
  "description": "AfricaTravel — Internal Travel Agency Management System",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "//": "NOTE: Migrations run in postinstall because vercel.json uses legacy 'builds' (@vercel/node), which bypasses npm 'build' on Vercel",
    "postinstall": "prisma generate --schema=database/prisma/schema.prisma && node scripts/deployment/migrate-if-production.js",
    "build": "prisma generate --schema=database/prisma/schema.prisma",
    "start": "node server.js",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:check-drift": "prisma migrate diff --from-schema-datasource database/prisma/schema.prisma --to-schema-datamodel database/prisma/schema.prisma --script",
    "db:check-unique-integrity": "node scripts/database/check-unique-integrity.js",
    "lint": "npx eslint backend/ tests/ frontend/js/",
    "prisma:seed": "node database/prisma/seed.js",
    "reset:passwords": "node scripts/maintenance/reset-admin-passwords.js",
    "test:business-flow": "node tests/integration/business-flow.test.js",
    "test:ticket-status": "node tests/unit/ticket-payment-status.test.js",
    "test:frontend": "node tests/integration/business-flow.test.js && node tests/integration/i18n-bilingual.test.js",
    "test:domain": "node tests/unit/backend-domain.test.js",
    "test:auth": "node tests/integration/backend-auth.test.js",
    "test:api": "node tests/integration/backend-api.test.js",
    "test:tickets": "node tests/integration/ticket-customer-link.test.js",
    "test:passport": "node tests/integration/passport-document.test.js",
    "test:roundtrip": "node tests/integration/round-trip-flight.test.js",
    "test:customer-payments": "node tests/integration/customer-payments-report.test.js",
    "test:rbac": "node tests/security/rbac-ui.test.js",
    "test:security-fixes": "node tests/security/security-fixes.test.js",
    "test:audit": "node tests/security/audit-fixes.test.js",
    "test:purge": "node tests/security/purge-actions.test.js",
    "test:employee-delete": "node tests/integration/employee-delete.test.js",
    "test:expenses": "node tests/integration/expenses.test.js",
    "test:visas": "node tests/integration/visas.test.js",
    "test:ai-extract": "node tests/integration/ticket-extraction.test.js",
    "test:airlines": "node tests/integration/airlines-catalog.test.js",
    "test:pwa": "node tests/integration/pwa-install.test.js",
    "test:mobile-search": "node tests/integration/mobile-search.test.js",
    "test:boot-splash": "node tests/integration/boot-splash.test.js",
    "test:hardening": "node tests/integration/production-hardening.test.js",
    "test:security-round2": "node tests/security/security-hardening-round2.test.js",
    "test:security-round3": "node tests/security/security-hardening-round3.test.js",
    "test:rate-limit": "node tests/security/rate-limiter.test.js",
    "test:postgres": "node tests/integration/postgres-integration.test.js",
    "test:customer-performance": "node tests/integration/customer-performance.test.js",
    "test:sidebar-collapse": "node tests/unit/sidebar-collapse-listener.test.js",
    "test:ticket-edit": "node tests/integration/ticket-edit-expansion.test.js",
    "test:audit-p0": "node tests/security/audit-p0-fixes.test.js",
    "test:schema-bounds": "node tests/unit/schema-bounds.test.js",
    "test:ticket-nullables": "node tests/unit/ticket-schema-nullables.test.js",
    "test:mod-split": "node tests/unit/flight-modification-fee-split.test.js",
    "test:dark-mode": "node tests/unit/dark-mode-html-integrity.test.js",
    "test:unit": "node scripts/testing/test-runner.js --unit",
    "test:integration": "node scripts/testing/test-runner.js --integration",
    "test:security": "node scripts/testing/test-runner.js --security",
    "test": "node scripts/testing/test-runner.js"
  },
  "keywords": [
    "travel",
    "agency",
    "ticketing",
    "operations",
    "i18n",
    "rtl",
    "backend",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "AfricaTravel Engineering",
  "license": "ISC",
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "node database/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/server": "^1.6.0",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "jsdom": "^26.0.0",
    "prisma": "^6.19.3"
  },
  "prettier": "./config/prettier.config.js"
}
